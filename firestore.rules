rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
       return isSignedIn() && (
         request.auth.uid == 'lMx7g98t0xVPQbtsBhOFLBB2w4h1' ||
         request.auth.token.email == 'bmate10@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid))
       );
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['name', 'rank']) &&
             data.keys().hasOnly(['name', 'rank', 'uid']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (data.rank is int || data.rank is float) && data.rank >= 1 && data.rank <= 200 &&
             (!('uid' in data) || (data.uid is string && data.uid.size() > 0));
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['opponent', 'location', 'date', 'season', 'status', 'homeAway']) &&
             data.opponent is string && data.opponent.size() > 0 && data.opponent.size() <= 100 &&
             data.location is string && data.location.size() > 0 && data.location.size() <= 200 &&
             data.date is timestamp &&
             data.season in ['Spring', 'Fall'] &&
             data.status in ['Scheduled', 'Completed'] &&
             data.homeAway in ['Home', 'Away'] &&
             (!('teamScore' in data) || data.teamScore is int || data.teamScore is float) &&
             (!('opponentScore' in data) || data.opponentScore is int || data.opponentScore is float) &&
             (!('selectedPlayerIds' in data) || data.selectedPlayerIds is list);
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // Only manageable via console or bootstrapping email
    }

    match /years/{yearId} {
      allow read: if isSignedIn();
      
      match /leagues/{leagueId} {
        allow read: if isSignedIn();
        
        match /players/{playerId} {
          allow read: if isSignedIn();
          allow create, update: if isAdmin() && isValidPlayer(incoming()) && isValidId(playerId);
          // Self-claim: a signed-in user may link themselves to an unclaimed player,
          // but only to their own uid, and only while it has no uid yet.
          allow update: if isSignedIn() &&
                            !('uid' in existing()) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['uid']) &&
                            incoming().uid == request.auth.uid;
          allow delete: if isAdmin();
        }

        match /matches/{matchId} {
          allow read: if isSignedIn();
          // Authenticated users can create valid matches
          allow create: if isSignedIn() && isValidMatch(incoming()) && isValidId(matchId);
          allow delete: if isAdmin();
          allow update: if isAdmin() && isValidMatch(incoming());

          match /mvpVotes/{voteId} {
            // voteId should be the userId to enforce one vote per user
            allow read: if isSignedIn();
            allow create: if isSignedIn() && request.auth.uid == voteId &&
                           incoming().playerId is string &&
                           incoming().voterId == request.auth.uid;
            allow delete: if isSignedIn() && request.auth.uid == voteId;
          }

          match /availability/{playerId} {
            // Only an admin, or the account linked to this specific player, may set it.
            allow read: if isSignedIn();
            allow create, update: if (isAdmin() ||
                                       (isSignedIn() &&
                                        get(/databases/$(database)/documents/years/$(yearId)/leagues/$(leagueId)/players/$(playerId)).data.uid == request.auth.uid)) &&
                                      incoming().status in ['Yes', 'No', 'If Needed'];
            allow delete: if isAdmin();
          }
        }
      }
    }
  }
}
